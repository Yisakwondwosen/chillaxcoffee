{
  "version": 2,
  "name": "chillaxcoffee",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "backend/**",
          "requirements.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "trailingSlash": false,
  "env": {
    "DJANGO_SETTINGS_MODULE": "chillax_backend.settings",
    "PYTHONPATH": "backend",
    "TELEGRAM_BOT_TOKEN": "8694804931:AAE3lyyVfPGZ0rxsHKFtBMqgo0I2IxFZ_n4",
    "TELEGRAM_STAFF_CHAT_ID": "6353858898"
  }
}
